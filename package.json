{
    "name": "gd-place",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "dev:api": "wrangler dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "db:create": "wrangler d1 create gdplace",
        "db:local": "wrangler d1 execute gdplace --local --file=schema.sql",
        "db:remote": "wrangler d1 execute gdplace --remote --file=schema.sql",
        "deploy": "npm run build && wrangler deploy"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^1.0.2",
        "@tsconfig/svelte": "^3.0.0",
        "@types/howler": "^2.2.7",
        "@types/lodash.debounce": "^4.0.7",
        "svelte": "^3.49.0",
        "svelte-check": "^2.8.1",
        "svelte-preprocess": "^4.10.7",
        "tslib": "^2.4.0",
        "typescript": "^4.6.4",
        "vite": "^3.1.0",
        "vite-plugin-full-reload": "^1.0.4",
        "wrangler": "^4.0.0"
    },
    "dependencies": {
        "@pixi/layers": "^1.0.11",
        "countup.js": "^2.3.2",
        "howler": "^2.2.3",
        "lodash.debounce": "^4.0.8",
        "pixi.js": "^6.5.8",
        "svelte-countup": "^0.2.6",
        "svelte-gestures": "^1.4.1",
        "svelte-motion": "^0.11.3",
        "warpspeed": "^2.0.6"
    }
}
